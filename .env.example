# Copy to .env (never commit .env).
HTTPS_PORT=8443          # host port for the HTTPS proxy
APP_VERSION=dev          # image tag; set to a release tag (e.g. v1.0.0) to deploy/rollback
IMAGE_REPO=school-api    # use ghcr.io/<owner>/<repo> to run images pulled from GHCR
SEED_DATA=true           # load synthetic demo data into an empty database
LOG_LEVEL=info           # info | debug
